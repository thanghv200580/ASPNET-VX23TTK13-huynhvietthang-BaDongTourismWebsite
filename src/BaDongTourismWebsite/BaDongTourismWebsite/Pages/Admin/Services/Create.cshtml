@page
@model BaDongTourismWebsite.Pages.Admin.Services.CreateModel
@{
    ViewData["Title"] = "Thêm Dịch Vụ Biển";
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
}

<div class="admin-page">
    <section class="admin-page-header">
        <div class="admin-page-heading">
            <span class="admin-page-subtitle">Tạo mới</span>
            <h2 class="admin-page-title">Thêm dịch vụ biển</h2>
        </div>
        <div class="admin-page-actions">
            <a asp-page="/Admin/Services/Index" class="btn btn-admin-ghost">
                <i class="fas fa-arrow-left me-2"></i>Danh sách
            </a>
        </div>
    </section>

    <form method="post" class="admin-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger admin-alert" role="alert"></div>

        <div class="admin-form-grid">
            <section class="admin-form-card">
                <div class="admin-form-section-title">Thông tin dịch vụ</div>
                <div class="row g-4">
                    <div class="col-12">
                        <label asp-for="Service.Name" class="form-label">Tên dịch vụ *</label>
                        <input asp-for="Service.Name" class="form-control" required placeholder="VD: Lướt sóng, Thuê cano...">
                        <span asp-validation-for="Service.Name" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Service.Description" class="form-label">Mô tả chi tiết *</label>
                        <textarea asp-for="Service.Description" class="form-control" rows="5" required placeholder="Mô tả chi tiết dịch vụ, thông tin cần biết..."></textarea>
                        <span asp-validation-for="Service.Description" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Service.Price" class="form-label">Giá (đồng) *</label>
                        <input asp-for="Service.Price" type="number" min="0" class="form-control" required placeholder="VD: 250000">
                        <span asp-validation-for="Service.Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Service.PriceUnit" class="form-label">Đơn vị giá</label>
                        <input asp-for="Service.PriceUnit" class="form-control" placeholder="VD: / người, / giờ, / lượt">
                        <span asp-validation-for="Service.PriceUnit" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Service.ContactPhone" class="form-label">Số điện thoại liên hệ</label>
                        <input asp-for="Service.ContactPhone" class="form-control" placeholder="VD: 0294.111.222">
                        <span asp-validation-for="Service.ContactPhone" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Service.DisplayOrder" class="form-label">Thứ tự hiển thị</label>
                        <input asp-for="Service.DisplayOrder" type="number" min="0" class="form-control" value="0">
                        <span asp-validation-for="Service.DisplayOrder" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Service.MainImage" class="form-label">Hình ảnh (URL)</label>
                        <input asp-for="Service.MainImage" class="form-control" placeholder="https://example.com/image.jpg">
                        <span asp-validation-for="Service.MainImage" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <aside class="admin-form-sidebar">
                <div class="admin-form-card">
                    <div class="admin-form-section-title">Hiển thị</div>
                    <div class="form-check form-switch mb-3">
                        <input asp-for="Service.IsActive" class="form-check-input" type="checkbox" checked>
                        <label asp-for="Service.IsActive" class="form-check-label">Hiển thị cho khách</label>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-admin-primary w-100">
                        <i class="fas fa-save me-2"></i>Lưu dịch vụ
                    </button>
                </div>
            </aside>
        </div>
    </form>
</div>
