@page
@model BaDongTourismWebsite.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
}

<div class="admin-page">
    <section class="admin-page-header">
        <div class="admin-page-heading">
            <span class="admin-page-subtitle">Tổng quan</span>
            <h2 class="admin-page-title">Dashboard</h2>
        </div>
        <div class="admin-page-actions">
            <a asp-page="/Admin/BeachInfoAdmin/Edit" class="btn btn-admin-ghost">
                <i class="fas fa-umbrella-beach me-2"></i>Chỉnh sửa thông tin bãi biển
            </a>
            <a asp-page="/Admin/Services/Create" class="btn btn-admin-primary">
                <i class="fas fa-plus me-2"></i>Thêm dịch vụ mới
            </a>
        </div>
    </section>

    <section class="admin-stat-grid">
        <article class="admin-stat-card">
            <div class="admin-stat-icon"><i class="fas fa-umbrella-beach"></i></div>
            <span class="admin-stat-label">Dịch vụ biển</span>
            <span class="admin-stat-value">@Model.TotalBeachServices</span>
        </article>
    </section>

    <div class="row g-4 mt-2">
        <div class="col-md-6">
            <div class="admin-card">
                <div class="admin-card-header"><h3>Thao tác nhanh</h3></div>
                <div class="admin-card-body">
                    <div class="d-grid gap-2">
                        <a asp-page="/Admin/BeachInfoAdmin/Edit" class="btn btn-outline-primary">
                            <i class="fas fa-edit me-2"></i>Chỉnh sửa thông tin Biển Ba Động
                        </a>
                        <a asp-page="/Admin/Services/Index" class="btn btn-outline-secondary">
                            <i class="fas fa-list me-2"></i>Quản lý dịch vụ biển
                        </a>
                        <a asp-page="/Admin/Services/Create" class="btn btn-outline-success">
                            <i class="fas fa-plus me-2"></i>Thêm dịch vụ mới
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="admin-card">
                <div class="admin-card-header"><h3>Thông tin hệ thống</h3></div>
                <div class="admin-card-body">
                    <p class="text-muted"><i class="fas fa-info-circle me-2 text-primary"></i>Website du lịch <strong>Biển Ba Động - Trà Vinh</strong></p>
                    <p class="text-muted"><i class="fas fa-globe me-2 text-success"></i>Trang công khai: <a asp-page="/Index" class="text-decoration-none">Trang chủ</a> · <a asp-page="/Services/Index" class="text-decoration-none">Dịch vụ biển</a></p>
                    <p class="text-muted mb-0"><i class="fas fa-lock me-2 text-warning"></i>Đăng nhập admin: <code>admin@badong.com</code></p>
                </div>
            </div>
        </div>
    </div>
</div>
